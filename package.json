{
  "name": "mcpscan-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "MCPScan monorepo for the MCP security scanner CLI.",
  "license": "MIT",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "clean": "rm -rf packages/shared/dist packages/cli/dist packages/shared/tsconfig.tsbuildinfo packages/cli/tsconfig.tsbuildinfo",
    "prepack": "npm run clean && npm run build && npm test",
    "pack:cli": "npm pack --dry-run -w mcpscan",
    "pack:shared": "npm pack --dry-run -w @mcpscan/shared",
    "landing:sample-report": "node scripts/generate-sample-report.mjs",
    "market:verify": "node scripts/verify-market-sources.mjs",
    "launch:apply-links": "node scripts/apply-approved-launch-links.mjs",
    "launch:apply-return-packet": "node scripts/apply-founder-return-packet.mjs",
    "launch:bundle": "node scripts/build-static-launch-bundle.mjs",
    "launch:open-bundle": "node scripts/open-static-launch-bundle.mjs",
    "launch:open": "node scripts/open-launch-cockpit.mjs",
    "launch:open-founder": "node scripts/open-founder-clicks.mjs",
    "launch:next": "node scripts/open-next-founder-action.mjs",
    "launch:open-return-review": "node scripts/open-founder-return-review.mjs",
    "launch:prepare-cheap": "node scripts/prepare-cheap-launch-packets.mjs",
    "launch:dns-packet": "node scripts/build-domain-dns-packet.mjs",
    "launch:stripe-packet": "node scripts/build-stripe-setup-packet.mjs",
    "launch:verify-stripe": "node scripts/verify-stripe-links.mjs",
    "launch:verify-stripe-qa": "node scripts/verify-stripe-checkout-qa.mjs",
    "launch:verify-dns": "node scripts/verify-domain-email-dns.mjs",
    "launch:post-click-verify": "node scripts/run-post-click-verification.mjs",
    "launch:verify": "node scripts/verify-launch-readiness.mjs",
    "launch:open-public-review": "node scripts/open-public-launch-review.mjs",
    "launch:stage-public-post": "node scripts/stage-approved-public-launch-post.mjs",
    "outbound:stage-approved": "node scripts/stage-approved-outbound.mjs",
    "outbound:open-first-10": "node scripts/open-first-10-outbound-approval.mjs",
    "outbound:open-send-gates": "node scripts/open-first-send-readiness.mjs",
    "outbound:open-reply-close": "node scripts/open-reply-to-close-review.mjs",
    "outbound:compose-final": "node scripts/compose-final-outbound.mjs",
    "outbound:compose-contact-routes": "node scripts/compose-contact-route-outbound.mjs",
    "outbound:route-packet": "node scripts/build-first-10-route-approval-packet.mjs",
    "outbound:stage-route-packet": "node scripts/stage-approved-route-packet.mjs",
    "outbound:stage-reply": "node scripts/stage-approved-reply.mjs",
    "outbound:log-send": "node scripts/log-approved-send.mjs",
    "outbound:log-route-batch": "node scripts/log-approved-route-batch-sends.mjs",
    "outbound:compose-follow-up": "node scripts/compose-follow-up-approval.mjs",
    "outbound:verify": "node scripts/verify-outbound-readiness.mjs",
    "outbound:send-gates": "node scripts/verify-first-send-gates.mjs",
    "outbound:queue": "node scripts/generate-outbound-approval-queue.mjs",
    "release:preflight": "node scripts/prepare-npm-release.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run build -w @mcpscan/shared && npm run typecheck --workspaces --if-present",
    "writing:check": "node scripts/check-writing-rules.mjs",
    "gtm:verify": "node scripts/verify-gtm-claims.mjs",
    "revenue:snapshot": "node scripts/build-revenue-snapshot.mjs",
    "delivery:workspace": "node scripts/create-customer-workspace.mjs",
    "delivery:open-handoff": "node scripts/open-paid-audit-handoff.mjs",
    "delivery:work-order": "node scripts/create-first-paid-audit-work-order.mjs",
    "delivery:handoff": "node scripts/create-paid-audit-handoff.mjs",
    "delivery:intake-message": "node scripts/compose-post-payment-intake.mjs",
    "delivery:verify": "node scripts/verify-delivery-readiness.mjs",
    "delivery:dry-run": "node scripts/run-delivery-dry-run.mjs",
    "launch:status": "node scripts/show-launch-status.mjs",
    "launch:status:live": "node scripts/show-launch-status.mjs --live"
  },
  "workspaces": [
    "packages/shared",
    "packages/cli"
  ],
  "devDependencies": {
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
